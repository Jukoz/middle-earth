{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "middle-earth:item/citrine_bullseye_lamp_flat"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "middle-earth:lamp_on",
      "cases": [
        {
          "when": true,
          "model": {
            "type": "minecraft:model",
            "model": "middle-earth:item/citrine_bullseye_lamp_lit"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "middle-earth:item/citrine_bullseye_lamp"
      }
    }
  }
}