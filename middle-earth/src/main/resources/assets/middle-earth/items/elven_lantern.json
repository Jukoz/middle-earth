{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui", "ground", "fixed"],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:component",
          "component": "middle-earth:lamp_on",
          "cases": [
            {
              "when": false,
              "model": {
                "type": "minecraft:model",
                "model": "middle-earth:item/held/shaded_elven_lantern_flat"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "middle-earth:item/elven_lantern"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "middle-earth:lamp_on",
      "cases": [
        {
          "when": false,
          "model": {
            "type": "minecraft:model",
            "model": "middle-earth:item/held/shaded_elven_lantern"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "middle-earth:item/held/elven_lantern"
      }
    }
  }
}
