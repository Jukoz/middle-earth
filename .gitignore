.gradle
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

run/
run2/
build/
src/main/generated/
bin/main/*
/middle-earth/src/main/generated/
/of-beasts-and-wild-things/src/main/generated
/ofhallsandheralds/src/main/generated
/.idea
/.run2

